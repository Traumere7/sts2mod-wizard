; ── 巫师：角色选择界面背景 ────────────────────────────────────
; 布局参照原版 char_select_bg_ironclad.tscn 实测：
;   根节点 Control 尺寸 2560 x 1200，pivot (1280, 600)
;   可见窗口 = 中心向左 1280、向右 640、向上 600、向下 478  →  1920 x 1078
;   即"窗口"整体偏左，右侧留给角色信息面板。
;
; 各层：
;   BgImage    —— 宽背景图 2560x1200，KEEP_ASPECT_COVERED 铺满
;   PanelShade —— 右侧信息面板的渐变压暗
;   ash1/ash2  —— 飘落的奥术微粒
;
; ⚠️ **不要在这里再叠一个角色 Sprite**：
;    `char_select_bg_wizard.png` **本身就是一张带角色的完整构图**
;    （巫师站在中偏左、掌心托着发光符文）。
;    曾经叠过一层 wizard_battle.png，结果画面上出现了两个巫师。
;    若以后要换"背景+角色分离"的做法，再把这个节点加回来。

[node name="WizardBg" type="Control"]
layout_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -960.0
offset_top = -523.0
offset_right = 1600.0
offset_bottom = 677.0
grow_horizontal = 2
grow_vertical = 2
pivot_offset = Vector2(1280, 600)

[node name="BgImage" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("1_wizbg")
expand_mode = 1
stretch_mode = 6

; ── 左侧信息区压暗（**真正的渐变**，不能再用 ColorRect）──────────────
; ⚠️ 2026-11-02 修：原来是一个硬边 `ColorRect`（alpha 0.36），盖住大半个屏幕，
;    在星空背景上能看到一条笔直的矩形阴影边界（用户截图报告）。
;    改成 GradientTexture2D 水平渐变（左 α=0.45 → 0.62 宽度处归零），并且节点**铺满整个根节点**
;    —— 可见窗口是 root 的 (0,0)-(1920,1078)，铺满后四条边全在屏幕外，任何尺寸下都不会看到硬边。

[node name="PanelShade" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = SubResource("GradientTexture2D_shade")
expand_mode = 1
stretch_mode = 0

